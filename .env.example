# Which voice: local (free, on this machine) | eleven (ElevenLabs) | files (your own WAVs).
# The first /papertalk run asks and fills this in (scripts/setup.mjs).
PAPERTALK_VOICE=
PAPERTALK_LOCAL_VOICE=am_michael

# Only for ElevenLabs. Paste the key yourself; this file stays on your machine.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PAPERTALK_MODEL=eleven_v3
